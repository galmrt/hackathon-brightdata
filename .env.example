# Public URL of the deployed demo app (apps/demo-app). Bright Data's
# regional proxies need a real public URL — never localhost.
DEMO_APP_URL=https://watchtower-gilt.vercel.app

# Bright Data API token (Scraper Studio / CLI auth). Never commit the real value.
BRIGHTDATA_API_TOKEN=

# SigNoz ingestion endpoint + API key (self-hosted or cloud — confirm during workshop).
SIGNOZ_ENDPOINT=
SIGNOZ_API_KEY=

# Port workflow webhook that probe-runner posts structured results to.
PORT_WEBHOOK_URL=
