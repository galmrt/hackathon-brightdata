# Public URL of the deployed demo app (apps/demo-app). Bright Data's
# regional proxies need a real public URL — never localhost.
DEMO_APP_URL=https://watchtower-gilt.vercel.app

# Bright Data API token (Scraper Studio / CLI auth). Never commit the real value.
BRIGHTDATA_API_TOKEN=

# Bright Data proxy zone customer ID and zone name — used by services/probe-runner
# to build the brd-customer-<id>-zone-<zone>-country-<cc> proxy username so each
# probe request routes through a specific region. Confirm at the workshop.
BRIGHTDATA_CUSTOMER_ID=
BRIGHTDATA_ZONE=
# Usually brd.superproxy.io:22225 — override only if the workshop provisions differently.
BRIGHTDATA_PROXY_HOST=
BRIGHTDATA_PROXY_PORT=

# SigNoz OTLP HTTP ingestion endpoint (e.g. https://ingest.<region>.signoz.cloud:443)
# + API key, used by services/probe-runner's OTel exporter. Confirm during workshop.
SIGNOZ_ENDPOINT=
SIGNOZ_API_KEY=

# Port workflow webhook that probe-runner posts structured results to.
PORT_WEBHOOK_URL=
