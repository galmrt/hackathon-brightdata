{
  "identifier": "watchtower_approve_auto_heal",
  "title": "Approve auto-heal",
  "icon": "Check",
  "description": "Human approval gate for the drift branch (CLAUDE.md §1/§4): confirms the agent-drafted repair description should be submitted to Bright Data's self-heal flow. Only offered while the incident is auto_heal_pending_approval.",
  "trigger": {
    "type": "self-service",
    "operation": "DAY-2",
    "blueprintIdentifier": "watchtowerIncident",
    "userInputs": {
      "properties": {},
      "required": []
    },
    "condition": {
      "type": "SEARCH",
      "combinator": "and",
      "rules": [
        {
          "property": "status",
          "operator": "=",
          "value": "auto_heal_pending_approval"
        }
      ]
    }
  },
  "invocationMethod": {
    "type": "UPSERT_ENTITY",
    "blueprintIdentifier": "watchtowerIncident",
    "mapping": {
      "identifier": "{{ .entity.identifier }}",
      "properties": {
        "status": "auto_heal_approved",
        "approvedBy": "{{ .trigger.by.user.email }}"
      }
    }
  },
  "requiredApproval": false,
  "publish": true
}
